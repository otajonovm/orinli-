# GEMINI_API_KEY: Required for Gemini AI API calls (server-side only).
# Never expose this key to the client.
# Local: put in .env | Vercel: Project Settings → Environment Variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# BNC corpus adapter (optional — not connected until both are set)
# Later: frequency list API or Sketch Engine proxy.
BNC_API_URL=
BNC_API_KEY=
